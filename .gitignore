# Local-only prepublish-check.py allowlist (real hostnames/emails/IPs
# this operator doesn't want the public-repo scanner to flag) — never
# committed, since committing it would be the leak the scanner exists
# to catch. See scripts/prepublish-check.py and docs/maintainers.md.
.prepublish-markers.local

# capture-screenshots.mjs's per-run bookkeeping (see docs/maintainers.md)
docs/screenshots/**/capture-report.json

# Session-local orchestration state, never a publication input.
.slim/deepwork/

# Local Compose credentials/configuration; keep .env.example tracked.
.env

# oh-my-claudecode session/agent state (local only)
.omc/
