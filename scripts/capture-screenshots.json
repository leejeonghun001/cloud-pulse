  {
    "name": "diagnosis",
    "route": "#/settings/notifications",
    "theme": "dark",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "actions": [
      {
        "type": "eval",
        "expression": "(() => { const b = Array.from(document.querySelectorAll('button')).find((x) => /edit/i.test(x.getAttribute('aria-label') || x.title || '')); b && b.click(); return !!b; })()",
        "waitAfterMs": 1500
      },
      {
        "type": "eval",
        "expression": "(() => { const d = document.querySelector('dialog[open]'); const b = d && Array.from(d.querySelectorAll('button')).find((x) => x.textContent.includes('Send test')); b && b.click(); return !!b; })()",
        "waitAfterMs": 4000
      },
      {
        "type": "eval",
        "expression": "(() => { const c = document.querySelector('dialog[open] .cp-diagnosis-card'); c && c.scrollIntoView({block: 'center'}); return !!c; })()",
        "waitAfterMs": 600
      }
    ]
  },
  {
    "name": "settings",
    "route": "#/settings/network",
    "theme": "dark",
    "viewport": {
      "width": 1440,
